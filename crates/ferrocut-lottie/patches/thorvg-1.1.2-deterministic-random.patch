diff -ruN a/src/loaders/lottie/tvgLottieRandom.h b/src/loaders/lottie/tvgLottieRandom.h
--- a/src/loaders/lottie/tvgLottieRandom.h
+++ b/src/loaders/lottie/tvgLottieRandom.h
@@ -0,0 +1,78 @@
+/*
+ * Ferrocut patch for ThorVG (MIT, same terms as ThorVG).
+ *
+ * Deterministic, thread-local replacement for libc rand() inside the Lottie
+ * loader (expression random()/wiggle(), JerryScript Math.random, text range
+ * selector "randomize"). libc rand() is process-global and history dependent,
+ * so the same frame rendered in a different order, process, or thread would
+ * differ. Here every expression evaluation is reseeded from
+ * (stable per-expression seed, frame number), so the result is a pure function
+ * of the document and the requested frame.
+ */
+#ifndef _TVG_LOTTIE_RANDOM_H_
+#define _TVG_LOTTIE_RANDOM_H_
+
+#include <cstdint>
+#include <cstring>
+
+namespace tvglottie
+{
+
+//function-local statics: one instance program-wide, valid C++11 (ThorVG builds as C++14)
+inline uint64_t& rngState()
+{
+    static thread_local uint64_t s = 0x853c49e6748fea9bULL;
+    return s;
+}
+
+inline uint32_t& parseCounter()
+{
+    static thread_local uint32_t c = 0;
+    return c;
+}
+
+inline uint64_t splitmix64(uint64_t& s)
+{
+    uint64_t z = (s += 0x9e3779b97f4a7c15ULL);
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    return z ^ (z >> 31);
+}
+
+inline uint32_t fnv1a(const char* s)
+{
+    uint32_t h = 2166136261u;
+    if (s) for (; *s; ++s) { h ^= (uint8_t)*s; h *= 16777619u; }
+    return h;
+}
+
+//stable across runs: content hash of the code + its position in document order
+inline uint32_t expressionSeed(const char* code)
+{
+    return fnv1a(code) ^ (++parseCounter() * 0x9E3779B9u);
+}
+
+//non-zero value in [1, 2^31-1] for parse-time randomization (text selectors)
+inline int parseRandom()
+{
+    uint64_t s = 0x5eedc0de00000000ULL ^ (uint64_t)(++parseCounter());
+    return (int)(splitmix64(s) >> 33) | 1;
+}
+
+inline void seedFrame(uint32_t expSeed, float frameNo)
+{
+    uint32_t bits;
+    memcpy(&bits, &frameNo, sizeof(bits));
+    uint64_t s = ((uint64_t)expSeed << 32) | bits;
+    rngState() = splitmix64(s);
+}
+
+//same range as glibc rand(): [0, RAND_MAX = 2^31-1]
+inline int rand()
+{
+    return (int)(splitmix64(rngState()) >> 33);
+}
+
+}
+
+#endif //_TVG_LOTTIE_RANDOM_H_
