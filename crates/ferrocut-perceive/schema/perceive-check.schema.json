{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferrocut.dev/schema/perceive-check.schema.json",
  "title": "ferrocut-perceive check report (ferrocut.perceive.check/1)",
  "description": "Printed by `ferrocut-perceive check --json`. Exit 0 = pass, 1 = fail, 2 = error (then the object is {schema_version, pass: false, problems: [], error}). `problems` holds failures only: pass == (problems is empty). Fields beyond schema_version/pass/problems[reason, range, measured, threshold] are additive.",
  "oneOf": [
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "rational": {
      "description": "Exact rational seconds in ferrocut-types serde form: \"num/den\" (reduced, den > 1) or \"num\".",
      "type": "string",
      "pattern": "^-?[0-9]+(/[0-9]+)?$"
    },
    "timecode": {
      "type": "string",
      "pattern": "^[0-9]{2,}:[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "range",
        "measured",
        "threshold",
        "severity",
        "timecode",
        "frames",
        "message"
      ],
      "properties": {
        "reason": {
          "description": "Stable code. Contract: missed_cut, extra_cut, black_frames, frozen_frames, flash, loudness_off_target, true_peak_over. Additive: missing_audio, audio_join_mismatch, loudness_target_mismatch (warning: the render's recorded loudness target or ceiling differs from the timeline's current audio.loudness).",
          "type": "string",
          "enum": [
            "missed_cut",
            "extra_cut",
            "black_frames",
            "frozen_frames",
            "flash",
            "loudness_off_target",
            "true_peak_over",
            "missing_audio",
            "audio_join_mismatch",
            "loudness_target_mismatch"
          ]
        },
        "range": {
          "description": "[start, end) in timeline seconds.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/rational"
          }
        },
        "measured": {
          "type": [
            "number",
            "null"
          ],
          "description": "Measured value in `unit`; null when there is none."
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ],
          "description": "Threshold in `unit`; for loudness_off_target the target (allowed deviation: `tolerance`)."
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "unit": {
          "enum": [
            "frames",
            "s",
            "LUFS",
            "dBTP",
            "LU",
            "distance"
          ]
        },
        "tolerance": {
          "type": "number"
        },
        "timecode": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/timecode"
          }
        },
        "frames": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer"
          }
        },
        "message": {
          "type": "string"
        },
        "threshold_sources": {
          "description": "Sources of the thresholds a loudness_off_target, true_peak_over or loudness_target_mismatch was held to.",
          "$ref": "#/$defs/threshold_sources"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_cuts",
        "cut_tolerance_frames",
        "loudness_target_lufs",
        "loudness_tolerance_lu",
        "max_black_frames",
        "max_edge_black_s",
        "max_flash_frames",
        "max_frozen_s",
        "require_audio",
        "true_peak_max_dbtp"
      ],
      "properties": {
        "loudness_target_lufs": {
          "type": "number"
        },
        "loudness_tolerance_lu": {
          "type": "number"
        },
        "true_peak_max_dbtp": {
          "type": "number"
        },
        "max_edge_black_s": {
          "type": "number"
        },
        "max_frozen_s": {
          "type": "number"
        },
        "cut_tolerance_frames": {
          "type": "integer"
        },
        "max_black_frames": {
          "type": "integer"
        },
        "max_flash_frames": {
          "type": "integer"
        },
        "require_audio": {
          "type": "boolean"
        },
        "check_cuts": {
          "type": "boolean"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "pass",
        "problems",
        "warnings",
        "thresholds",
        "measured",
        "perceive_schema_version"
      ],
      "properties": {
        "schema_version": {
          "const": "ferrocut.perceive.check/1"
        },
        "pass": {
          "type": "boolean"
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/problem"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/problem"
          }
        },
        "thresholds": {
          "$ref": "#/$defs/thresholds"
        },
        "measured": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frames",
            "fps",
            "duration",
            "integrated_lufs",
            "true_peak_dbtp",
            "expected_cuts",
            "detected_cuts",
            "cuts_from"
          ],
          "properties": {
            "frames": {
              "type": "integer"
            },
            "fps": {
              "$ref": "#/$defs/rational"
            },
            "duration": {
              "$ref": "#/$defs/rational"
            },
            "integrated_lufs": {
              "type": [
                "number",
                "null"
              ]
            },
            "true_peak_dbtp": {
              "type": [
                "number",
                "null"
              ]
            },
            "expected_cuts": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "detected_cuts": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "cuts_from": {
              "enum": [
                "brief",
                "timeline"
              ]
            }
          }
        },
        "perceive_schema_version": {
          "type": "string"
        },
        "threshold_sources": {
          "description": "Source of every threshold.",
          "$ref": "#/$defs/threshold_sources"
        },
        "loudness_target": {
          "description": "The audio thresholds used, each with its source.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_lufs",
            "tolerance_lu",
            "true_peak_max_dbtp"
          ],
          "properties": {
            "target_lufs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "source"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "source": {
                  "$ref": "#/$defs/threshold_source"
                }
              }
            },
            "tolerance_lu": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "source"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "source": {
                  "$ref": "#/$defs/threshold_source"
                }
              }
            },
            "true_peak_max_dbtp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "source"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "source": {
                  "$ref": "#/$defs/threshold_source"
                }
              }
            }
          }
        },
        "render_chunks": {
          "description": "How the checker resolved the render report's chunk_dir. Omitted when grading did not resolve one.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resolved_by"
          ],
          "properties": {
            "chunk_dir": {
              "type": [
                "string",
                "null"
              ]
            },
            "resolved_by": {
              "enum": [
                "recorded",
                "report_location",
                "process_cwd",
                "cache_dir_override",
                "report_default_cache",
                "ambiguous",
                "unresolved",
                "absent"
              ]
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "pass",
        "problems",
        "error"
      ],
      "properties": {
        "schema_version": {
          "const": "ferrocut.perceive.check/1"
        },
        "pass": {
          "const": false
        },
        "problems": {
          "type": "array",
          "maxItems": 0
        },
        "error": {
          "type": "string"
        }
      }
    },
    "threshold_source": {
      "description": "Where a threshold came from: flag, a key in the config file, the render's recorded loudness target/ceiling, the timeline's audio.loudness (when the render report lacks them), or the default.",
      "enum": [
        "flag",
        "config",
        "render",
        "timeline",
        "default"
      ]
    },
    "threshold_sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/threshold_source"
      }
    }
  }
}
