    "ferrocut edit /tmp/ferrocut-storytold-workflow.json examples/storytold-revise.ops --plan --json",
    "ferrocut render /tmp/ferrocut-storytold-workflow.json -o /tmp/ferrocut-storytold-revised.mkv --cpu -j1",
    "repeat render to /tmp/ferrocut-storytold-repeat.mkv",
    "ferrocut undo /tmp/ferrocut-storytold-workflow.json --json",
    "render restored timeline to /tmp/ferrocut-storytold-undo.mkv"
  ],
