[
  {
    "mcp": "edit_apply",
    "args": {
      "timeline": "timeline.json",
      "ops": [
        { "op": "add_transition", "clip": "b", "duration": "1", "align": "center" },
        { "op": "set_keyframes", "clip": "a", "param": "opacity",
          "keyframes": [ { "t": "0", "v": "0" }, { "t": "1", "v": "1" } ] },
        { "op": "set_keyframes", "clip": "b", "param": "opacity", "timeline_time": true,
          "keyframes": [ { "t": "9", "v": "1" }, { "t": "10", "v": "0" } ] }
      ]
    }
  },
  {
    "mcp": "plan",
    "args": {
      "timeline": "timeline.json"
    }
  },
  {
    "mcp": "render",
    "args": {
      "timeline": "timeline.json",
      "output": "out.mkv"
    }
  }
]
